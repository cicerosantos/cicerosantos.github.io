  "events": [
    {
      "id": "vref",
      "label": "Reference 12 → 15 V",
      "about": "12 V in, 6 Ω, reference slew 10 V/ms: the output rises above the input."
    },
    {
      "id": "vin",
      "label": "Input 9 → 15 V",
      "about": "12 V out, 6 Ω, input slew 10 V/ms: the input crosses the output, from boosting to bucking, and the duty goes from about 0.58 to 0.45."
    },
    {
      "id": "load",
      "label": "Load 1 → 3 A",
      "about": "12 V → 12 V, load 12 → 4 Ω (1 → 3 A)."
    },
    {
      "id": "vref-step",
      "label": "Reference 12 → 8 V, no slew",
      "about": "The reference steps at once: the PID's derivative kick drops the duty to 0.08 for one period, and within five periods it is back near its old value. The inductor current reverses anyway, down to −4 A, and for about 0.1 ms Q1 carries it back to the input."
    }
  ],
