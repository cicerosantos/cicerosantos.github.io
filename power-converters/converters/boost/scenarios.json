    {
      "id": "aggressive",
      "label": "Aggressive",
      "about": "Zeros at 700 Hz, on the LC resonance, with the crossover pushed to 4 kHz and the pole down to 10 kHz: phase margin 19° at 1 A, but 1° at 2 A, where the right-half-plane zero comes down to 7 kHz (gain margin 0.1 dB). Fast on the reference and input steps; the load step rings for milliseconds.",
      "design": {
        "form": "2p2z",
        "fc": 4000,
