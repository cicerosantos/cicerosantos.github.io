{
  "title": "Synchronous buck, 24 V → 9 V, 200 kHz",
  "periods": 400,
  "defaults": { "vin": 24, "vref": 9, "load": 9, "slew": 50, "vinSlew": 20 },
  "controllers": [
    { "id": "pid", "label": "Original PID",
      "about": "The PID of buck-pid.cir: KP 0.0565, KI 1309, KD 1.5 µs, no derivative filter. Phase margin 25° at 8.9 kHz.",
      "controller": { "form": "pid", "values": [0.0565, 1309, 1.5e-6, 0] } },
    { "id": "2p2z", "label": "2p2z",
      "about": "The Bode window's default design: crossover 8 kHz, two zeros at 2 kHz, pole at 60 kHz, matched to z. Phase margin 41°, gain margin 13.9 dB.",
      "design": { "form": "2p2z", "fc": 8000, "fz1": 2000, "fz2": 2000, "fp": 60000 },
      "controller": { "form": "2p2z", "values": [0.23114164305307777, -0.43413086611968615, 0.20384644500704488, 0.15183580198064886] } },
    { "id": "aggressive", "label": "Aggressive",
      "about": "The same zeros and pole with the crossover pushed to 18 kHz: phase margin 16°, gain margin 2.7 dB. Stable, but every step rings.",
      "design": { "form": "2p2z", "fc": 18000, "fz1": 2000, "fz2": 2000, "fp": 60000 },
      "controller": { "form": "2p2z", "values": [0.8411989478410925, -1.5799421643868923, 0.7418629235135136, 0.15183580198064886] } },
    { "id": "unstable", "label": "Unstable",
      "about": "Crossover 25 kHz, zeros at 3 kHz, pole at 40 kHz: phase margin −18°, gain margin −3.2 dB. The loop oscillates near 19 kHz before any step, limited only by the duty's clamp, and the output's average drifts to about 11 V.",
      "design": { "form": "2p2z", "fc": 25000, "fz1": 3000, "fz2": 3000, "fp": 40000 },
      "controller": { "form": "2p2z", "values": [1.189988535650059, -2.165915366379592, 0.9855534809326064, 0.2846095433360292] } }
  ],
  "events": [
    { "id": "vref", "label": "Reference 9 → 5 V", "about": "24 V in, 9 Ω, reference slew 50 V/ms." },
    { "id": "vin", "label": "Input 24 → 18 V", "about": "9 V out, 9 Ω, input slew 20 V/ms, like a bench supply." },
    { "id": "load", "label": "Load 1 → 2 A", "about": "24 V → 9 V, load 9 → 4.5 Ω." },
    { "id": "vref-step", "label": "Reference 9 → 5 V, no slew", "about": "The reference steps at once: the error jumps, the duty saturates at zero and the inductor current goes negative." }
  ],
  "scenarios": [
    { "id": "pid-vref", "controller": "pid", "event": "vref", "step": ["vref", 5], "file": "data/pid-vref.bin" },
    { "id": "pid-vin", "controller": "pid", "event": "vin", "step": ["vin", 18], "file": "data/pid-vin.bin" },
    { "id": "pid-load", "controller": "pid", "event": "load", "step": ["load", 4.5], "file": "data/pid-load.bin" },
    { "id": "pid-vref-step", "controller": "pid", "event": "vref-step", "initial": { "slew": 0 }, "step": ["vref", 5], "file": "data/pid-vref-step.bin" },
    { "id": "2p2z-vref", "controller": "2p2z", "event": "vref", "step": ["vref", 5], "file": "data/2p2z-vref.bin" },
    { "id": "2p2z-vin", "controller": "2p2z", "event": "vin", "step": ["vin", 18], "file": "data/2p2z-vin.bin" },
    { "id": "2p2z-load", "controller": "2p2z", "event": "load", "step": ["load", 4.5], "file": "data/2p2z-load.bin" },
    { "id": "aggressive-vref", "controller": "aggressive", "event": "vref", "step": ["vref", 5], "file": "data/aggressive-vref.bin" },
    { "id": "aggressive-vin", "controller": "aggressive", "event": "vin", "step": ["vin", 18], "file": "data/aggressive-vin.bin" },
    { "id": "aggressive-load", "controller": "aggressive", "event": "load", "step": ["load", 4.5], "file": "data/aggressive-load.bin" },
    { "id": "unstable-vref", "controller": "unstable", "event": "vref", "step": ["vref", 5], "file": "data/unstable-vref.bin" },
    { "id": "unstable-vin", "controller": "unstable", "event": "vin", "step": ["vin", 18], "file": "data/unstable-vin.bin" },
    { "id": "unstable-load", "controller": "unstable", "event": "load", "step": ["load", 4.5], "file": "data/unstable-load.bin" }
  ]
}
